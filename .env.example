# Archivo de ejemplo de configuración. Cópialo a `.env` y rellena sólo lo que necesites.
#
# Este proyecto NO incluye claves ni realiza cobros por defecto.
# Sólo admite un endpoint compatible con la API de OpenAI que TÚ conectes.
# Mientras NOVEL_LLM_BASE_URL y NOVEL_LLM_MODEL estén vacíos, el servidor
# responde con un error de configuración y no llama a ningún proveedor.

# Endpoint OpenAI-compatible (ejemplo local: http://127.0.0.1:20128/v1).
# Puede ser un gateway local, un proxy propio o cualquier proveedor con cuota gratuita.
NOVEL_LLM_BASE_URL=

# Clave de API del proveedor. Déjala vacía si tu endpoint no exige autenticación.
NOVEL_LLM_API_KEY=

# Identificador del modelo, tal como lo espere tu endpoint (ej. un modelo gratuito
# que hayas verificado tú mismo). No se cambia solo ni cae a uno pagado.
NOVEL_LLM_MODEL=

# Puertos locales. Se enlazan sólo a 127.0.0.1: no se exponen a la red.
NOVEL_WRITER_PORT=8788
N8N_PORT=5679
